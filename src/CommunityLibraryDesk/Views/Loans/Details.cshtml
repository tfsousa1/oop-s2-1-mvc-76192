@model CommunityLibraryDesk.Models.Loan

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Loan</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Book
        </dt>
        <dd class="col-sm-10">
            @(Model.Book?.Title ?? "")
        </dd>

        <dt class="col-sm-2">
            Member
        </dt>
        <dd class="col-sm-10">
            @(Model.Member?.Email ?? "")
        </dd>

        <dt class="col-sm-2">
            LoanDate
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LoanDate)
        </dd>

        <dt class="col-sm-2">
            DueDate
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DueDate)
        </dd>

        <dt class="col-sm-2">
            ReturnedDate
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ReturnedDate)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
